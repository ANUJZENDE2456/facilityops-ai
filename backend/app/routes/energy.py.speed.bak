"""
Energy Intelligence API routes.
"""

from datetime import timedelta

import pandas as pd
from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy import func, select
from sqlalchemy.orm import Session

from app.agents.energy_agent import (
    ELECTRICITY_TARIFF_PER_KWH,
    EnergyAgent,
)
from app.database import get_db
from app.models.energy_reading import EnergyReading

router = APIRouter(prefix="/energy", tags=["Energy Intelligence"])
energy_agent = EnergyAgent()

MAIN_METER = "MAIN-METER-01"
CO2_KG_PER_KWH = 0.82  # approximate grid emission factor


def _load(db: Session, facility_id: int, hours: int, meter_id: str | None = None):
    """Load readings for the last `hours` hours of available data."""
    latest = db.scalar(
        select(func.max(EnergyReading.recorded_at)).where(
            EnergyReading.facility_id == facility_id
        )
    )
    if latest is None:
        raise HTTPException(404, "No energy readings found for this facility.")

    query = select(
        EnergyReading.meter_id,
        EnergyReading.recorded_at,
        EnergyReading.power_kw,
        EnergyReading.energy_kwh,
    ).where(
        EnergyReading.facility_id == facility_id,
        EnergyReading.recorded_at > latest - timedelta(hours=hours),
    )
    if meter_id:
        query = query.where(EnergyReading.meter_id == meter_id)

    rows = db.execute(query.order_by(EnergyReading.recorded_at)).all()
    df = pd.DataFrame(
        rows, columns=["meter_id", "recorded_at", "power_kw", "energy_kwh"]
    )
    return latest, df


@router.get("/analyze")
def analyze_energy(
    facility_id: int = Query(default=1, ge=1),
    db: Session = Depends(get_db),
):
    """Run energy consumption analysis and anomaly detection (last 24h)."""
    try:
        return energy_agent.run(db=db, facility_id=facility_id)
    except ValueError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (FileNotFoundError, RuntimeError) as exc:
        raise HTTPException(status_code=503, detail=str(exc))


@router.get("/anomalies")
def anomalies(
    facility_id: int = Query(default=1, ge=1),
    hours: int = Query(default=168, ge=24, le=720),
    db: Session = Depends(get_db),
):
    """Anomalies detected over a longer window (default 7 days)."""
    try:
        result = energy_agent.run(db=db, facility_id=facility_id, window_hours=hours)
    except ValueError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except (FileNotFoundError, RuntimeError) as exc:
        raise HTTPException(status_code=503, detail=str(exc))
    return {
        "analysis_window": result["analysis_window"],
        "anomaly_summary": result["anomaly_summary"],
        "anomalies": result["anomalies"],
        "recommendations": result["recommendations"],
    }


@router.get("/timeseries")
def timeseries(
    facility_id: int = Query(default=1, ge=1),
    meter_id: str = Query(default=MAIN_METER),
    hours: int = Query(default=168, ge=1, le=720),
    db: Session = Depends(get_db),
):
    """Hourly power/energy for one meter (for line charts)."""
    _, df = _load(db, facility_id, hours, meter_id)
    return {
        "meter_id": meter_id,
        "points": [
            {
                "timestamp": r.recorded_at.isoformat(),
                "power_kw": round(float(r.power_kw), 2),
                "energy_kwh": round(float(r.energy_kwh), 2),
            }
            for r in df.itertuples()
        ],
    }


@router.get("/summary")
def summary(
    facility_id: int = Query(default=1, ge=1),
    days: int = Query(default=30, ge=1, le=90),
    db: Session = Depends(get_db),
):
    """Period KPIs, per-meter breakdown and weekday-by-hour heatmap data."""
    latest, df = _load(db, facility_id, days * 24)

    main = df[df.meter_id == MAIN_METER]
    if main.empty:
        main = df
    total_kwh = float(main.energy_kwh.sum())

    ts = pd.to_datetime(main.recorded_at)
    hour, weekday = ts.dt.hour, ts.dt.weekday  # weekday: 0 = Monday
    off_hours = (weekday >= 5) | (hour < 7) | (hour >= 20)
    off_share = (
        float(main.energy_kwh[off_hours].sum()) / total_kwh * 100 if total_kwh else 0.0
    )

    breakdown = [
        {
            "meter_id": meter,
            "energy_kwh": round(float(kwh), 2),
            "cost_inr": round(float(kwh) * ELECTRICITY_TARIFF_PER_KWH, 2),
        }
        for meter, kwh in df.groupby("meter_id").energy_kwh.sum().items()
    ]

    heat = (
        main.assign(weekday=weekday, hour=hour)
        .groupby(["weekday", "hour"])
        .power_kw.mean()
        .round(2)
        .reset_index()
    )

    return {
        "period": {
            "from": (latest - timedelta(hours=days * 24)).isoformat(),
            "to": latest.isoformat(),
            "days": days,
        },
        "kpis": {
            "total_energy_kwh": round(total_kwh, 2),
            "cost_inr": round(total_kwh * ELECTRICITY_TARIFF_PER_KWH, 2),
            "carbon_tco2e": round(total_kwh * CO2_KG_PER_KWH / 1000, 2),
            "average_power_kw": round(float(main.power_kw.mean()), 2),
            "peak_power_kw": round(float(main.power_kw.max()), 2),
            "off_hours_share_pct": round(off_share, 1),
        },
        "meter_breakdown": breakdown,
        "heatmap": heat.to_dict("records"),
    }


# ======================= Step 4: multi-building + AI agent =======================
from pydantic import BaseModel  # noqa: E402

from app.models.facility import Facility  # noqa: E402
from app.services import ai_agent  # noqa: E402


class AskRequest(BaseModel):
    facility_id: int = 1
    question: str


@router.get("/facilities")
def facilities(db: Session = Depends(get_db)):
    """List monitored buildings."""
    rows = db.scalars(select(Facility).order_by(Facility.id)).all()
    return [{"id": f.id, "name": f.name, "location": f.location, "building_type": f.building_type} for f in rows]


@router.get("/campus")
def campus(db: Session = Depends(get_db)):
    """Campus-wide comparison of all buildings (30-day energy, cost, 7-day anomalies)."""
    out = []
    for f in db.scalars(select(Facility).order_by(Facility.id)).all():
        try:
            _, df = _load(db, f.id, 30 * 24)
        except HTTPException:
            continue
        main = df[df.meter_id == MAIN_METER]
        main = main if not main.empty else df
        kwh = float(main.energy_kwh.sum())
        try:
            an = energy_agent.run(db=db, facility_id=f.id, window_hours=168)["anomaly_summary"]
        except Exception:
            an = {"total": 0, "critical": 0, "high": 0}
        out.append({
            "facility_id": f.id, "name": f.name, "building_type": f.building_type,
            "energy_kwh": round(kwh, 2), "cost_inr": round(kwh * ELECTRICITY_TARIFF_PER_KWH, 2),
            "peak_power_kw": round(float(main.power_kw.max()), 2),
            "anomalies_7d": an["total"], "critical_7d": an["critical"], "high_7d": an["high"],
        })
    return {
        "buildings": out,
        "totals": {
            "buildings": len(out),
            "energy_kwh": round(sum(b["energy_kwh"] for b in out), 2),
            "cost_inr": round(sum(b["cost_inr"] for b in out), 2),
            "anomalies_7d": sum(b["anomalies_7d"] for b in out),
        },
    }


@router.post("/ask")
def ask(body: AskRequest, db: Session = Depends(get_db)):
    """AI Energy Agent: answer a question using the platform's analysis (LLM if key set, else rules)."""
    facility = db.get(Facility, body.facility_id)
    if facility is None:
        raise HTTPException(404, "Facility not found.")
    try:
        analysis = energy_agent.run(db=db, facility_id=body.facility_id, window_hours=168)
    except (ValueError, FileNotFoundError, RuntimeError) as exc:
        raise HTTPException(503, str(exc))
    context = ai_agent.build_context(
        summary(facility_id=body.facility_id, days=30, db=db), analysis, facility.name
    )
    return ai_agent.answer(body.question, context)
