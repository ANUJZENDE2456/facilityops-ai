
"""
Energy Intelligence API routes.
"""

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy.orm import Session

from app.database import get_db
from app.agents.energy_agent import EnergyAgent


router = APIRouter(
    prefix="/energy",
    tags=["Energy Intelligence"],
)

energy_agent = EnergyAgent()


@router.get("/analyze")
def analyze_energy(
    facility_id: int = Query(default=1, ge=1),
    db: Session = Depends(get_db),
):
    """Run energy consumption analysis and anomaly detection."""

    try:
        return energy_agent.run(
            db=db,
            facility_id=facility_id,
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=404,
            detail=str(exc),
        )

    except (FileNotFoundError, RuntimeError) as exc:
        raise HTTPException(
            status_code=503,
            detail=str(exc),
        )
