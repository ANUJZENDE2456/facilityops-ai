
"""
Energy Intelligence Agent.

Loads trained meter-specific anomaly detectors, analyses recent
facility telemetry, and generates actionable energy recommendations.
"""

from functools import lru_cache
from pathlib import Path
from datetime import timedelta

import pandas as pd
from sqlalchemy import func, select
from sqlalchemy.orm import Session

from app.models import EnergyReading, Facility
from app.ml.model import MeterAnomalyDetector


ARTIFACTS_DIR = (
    Path(__file__).resolve().parents[2]
    / "artifacts"
    / "causal_v2"
)

OUTPUT_WINDOW_HOURS = 24
HISTORY_WINDOW_HOURS = 96
ELECTRICITY_TARIFF_PER_KWH = 8.0


@lru_cache(maxsize=1)
def load_detectors():
    """Load all trained meter-specific anomaly detectors once."""

    meter_ids = [
        "HVAC-01",
        "LIGHTING-01",
        "PLUG-LOAD-01",
        "MAIN-METER-01",
    ]

    detectors = {}

    for meter_id in meter_ids:
        model_path = ARTIFACTS_DIR / f"model_{meter_id}.joblib"

        if not model_path.exists():
            raise FileNotFoundError(
                f"Trained model not found: {model_path}"
            )

        detector = MeterAnomalyDetector.load(str(model_path))

        if not detector.pipeline.is_fitted:
            raise RuntimeError(
                f"Feature pipeline is not fitted for {meter_id}"
            )

        detectors[meter_id] = detector

    return detectors


class EnergyAgent:
    """Analyse facility energy consumption and identify anomalies."""

    def run(self, db: Session, facility_id: int = 1) -> dict:
        # Verify facility
        facility = db.get(Facility, facility_id)

        if facility is None:
            raise ValueError(
                f"Facility {facility_id} does not exist."
            )

        # Find latest available telemetry timestamp
        latest_timestamp = db.scalar(
            select(func.max(EnergyReading.recorded_at)).where(
                EnergyReading.facility_id == facility_id
            )
        )

        if latest_timestamp is None:
            raise ValueError("No energy readings found for this facility.")

        # Use 72+ hours of history for causal rolling features,
        # then analyse the most recent 24 hours.
        history_start = latest_timestamp - timedelta(
            hours=HISTORY_WINDOW_HOURS
        )
        output_start = latest_timestamp - timedelta(
            hours=OUTPUT_WINDOW_HOURS
        )

        readings = db.scalars(
            select(EnergyReading)
            .where(
                EnergyReading.facility_id == facility_id,
                EnergyReading.recorded_at >= history_start,
                EnergyReading.recorded_at <= latest_timestamp,
            )
            .order_by(
                EnergyReading.meter_id,
                EnergyReading.recorded_at,
            )
        ).all()

        if not readings:
            raise ValueError("No telemetry available for analysis.")

        data = pd.DataFrame([
            {
                "meter_id": reading.meter_id,
                "recorded_at": reading.recorded_at,
                "power_kw": reading.power_kw,
                "energy_kwh": reading.energy_kwh,
            }
            for reading in readings
        ])

        detectors = load_detectors()
        analysed_frames = []

        # Analyse each meter independently using its trained model.
        for meter_id, meter_data in data.groupby("meter_id"):
            detector = detectors.get(meter_id)

            if detector is None:
                continue

            meter_data = meter_data.sort_values(
                "recorded_at"
            ).reset_index(drop=True)

            predictions = detector.evaluate_readings(
                meter_data[["recorded_at", "power_kw"]]
            )

            predictions["meter_id"] = meter_id
            predictions["energy_kwh"] = (
                meter_data["energy_kwh"].to_numpy()
            )

            predictions = predictions[
                predictions["recorded_at"] > output_start
            ]

            analysed_frames.append(predictions)

        if not analysed_frames:
            raise ValueError(
                "No readings matched the available trained meter models."
            )

        analysed = pd.concat(
            analysed_frames,
            ignore_index=True,
        )

        # Use the main meter for facility-level consumption.
        # This avoids double-counting the submeters.
        main_meter = analysed[
            analysed["meter_id"] == "MAIN-METER-01"
        ]

        if main_meter.empty:
            main_meter = analysed[
                analysed["meter_id"] != "MAIN-METER-01"
            ]

        total_energy = round(
            float(main_meter["energy_kwh"].sum()), 2
        )
        average_power = round(
            float(main_meter["power_kw"].mean()), 2
        )
        peak_power = round(
            float(main_meter["power_kw"].max()), 2
        )
        daily_cost = round(
            total_energy * ELECTRICITY_TARIFF_PER_KWH, 2
        )
        monthly_cost_estimate = round(
           daily_cost * 30, 2
        )

        annual_cost_estimate = round(
           daily_cost * 365, 2
        )

        anomalies = analysed[
            analysed["predicted_anomaly"] == 1
        ].copy()

        anomalies = anomalies.sort_values(
            "anomaly_score",
            ascending=False,
        )

        recommendations = self._generate_recommendations(
            anomalies
        )
        # Meter-level analytics for the dashboard
        meter_summary = []

        for meter_id, group in analysed.groupby("meter_id"):
            latest = group.sort_values("recorded_at").iloc[-1]

            meter_summary.append({
                "meter_id": meter_id,
                "average_power_kw": round(
                    float(group["power_kw"].mean()), 2
                ),
                "peak_power_kw": round(
                    float(group["power_kw"].max()), 2
                ),
                "latest_power_kw": round(
                    float(latest["power_kw"]), 2
                ),
                "energy_kwh": round(
                    float(group["energy_kwh"].sum()), 2
                ),
                "estimated_cost_inr": round(
                    float(group["energy_kwh"].sum())
                    * ELECTRICITY_TARIFF_PER_KWH,
                    2
                ),
                "anomaly_count": int(
                    (group["predicted_anomaly"] == 1).sum()
                ),
                
            })

        # Hourly facility consumption from the main meter only
        hourly_consumption = [
            {
                "timestamp": row["recorded_at"].isoformat(),
                "energy_kwh": round(float(row["energy_kwh"]), 2),
            }
            for _, row in main_meter.sort_values(
                "recorded_at"
            ).iterrows()
        ]
        anomaly_records = []

        for row in anomalies.to_dict("records"):
            anomaly_records.append({
                "meter_id": row["meter_id"],
                "recorded_at": row["recorded_at"].isoformat(),
                "power_kw": round(float(row["power_kw"]), 2),
                "anomaly_score": float(row["anomaly_score"]),
                "severity": row["severity"],
            })

        return {
            "facility": {
                "id": facility.id,
                "name": facility.name,
                "location": facility.location,
            },
            "analysis_window": {
                "from": output_start.isoformat(),
                "to": latest_timestamp.isoformat(),
            },
            "consumption": {
                "total_energy_kwh": total_energy,
                "average_power_kw": average_power,
                "peak_power_kw": peak_power,
            },
            "cost_analysis": {
            "tariff_per_kwh": ELECTRICITY_TARIFF_PER_KWH,
            "daily_cost_inr": daily_cost,
            "monthly_cost_estimate_inr": monthly_cost_estimate,
            "annual_cost_estimate_inr": annual_cost_estimate,
            },
            "meter_summary": meter_summary,
            "hourly_consumption": hourly_consumption,
            "anomaly_summary": {
                "total": len(anomalies),
                "critical": int(
                    (anomalies["severity"] == "CRITICAL").sum()
                ),
                "high": int(
                    (anomalies["severity"] == "HIGH").sum()
                ),
                "medium": int(
                    (anomalies["severity"] == "MEDIUM").sum()
                ),
                "low": int(
                    (anomalies["severity"] == "LOW").sum()
                ),
            },
            "anomalies": anomaly_records,
            "recommendations": recommendations,
        }

    @staticmethod
    def _generate_recommendations(anomalies: pd.DataFrame) -> list:
        """Generate explainable recommendations from detected anomalies."""

        recommendations = []

        if anomalies.empty:
            return [{
                "priority": "LOW",
                "category": "Monitoring",
                "title": "Continue energy monitoring",
                "description": (
                    "No abnormal consumption was detected in the "
                    "analysis window. Continue monitoring meter readings."
                ),
            }]

        for meter_id, group in anomalies.groupby("meter_id"):
            count = len(group)
            highest_severity = group["severity"].iloc[
                group["anomaly_score"].argmax()
            ]

            if meter_id == "HVAC-01":
                description = (
                    f"{count} abnormal HVAC readings detected. "
                    "Inspect HVAC schedules, chiller operation, "
                    "and overnight temperature settings."
                )
                category = "HVAC Efficiency"

            elif meter_id == "LIGHTING-01":
                description = (
                    f"{count} abnormal lighting readings detected. "
                    "Check occupancy-based lighting controls and "
                    "ensure lights switch off in unused areas."
                )
                category = "Lighting Optimization"

            elif meter_id == "PLUG-LOAD-01":
                description = (
                    f"{count} abnormal plug-load readings detected. "
                    "Inspect equipment left running after working "
                    "hours and review standby power consumption."
                )
                category = "Equipment Optimization"

            else:
                description = (
                    f"{count} abnormal main-meter readings detected. "
                    "Investigate facility-wide consumption and "
                    "compare submeter readings to identify the source."
                )
                category = "Facility Energy Management"

            priority = (
                "CRITICAL"
                if highest_severity == "CRITICAL"
                else "HIGH"
                if highest_severity == "HIGH"
                else "MEDIUM"
            )

            recommendations.append({
                "priority": priority,
                "category": category,
                "title": f"Investigate {meter_id} consumption",
                "description": description,
                "affected_readings": count,
            })

        return recommendations
