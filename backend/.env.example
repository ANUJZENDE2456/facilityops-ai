# ==============================================================================
# Agentic FacilityOps AI Platform - Environment Configuration Example
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Application Environment
APP_NAME="Agentic FacilityOps AI Platform"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# Database Configuration (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5433
DB_NAME="facilityops_db"
DB_USER="facilityops"
DB_PASSWORD="YOUR_PASSWORD"
DATABASE_URL="postgresql+psycopg://facilityops:YOUR_PASSWORD@localhost:5433/facilityops_db"

# AI / LLM Orchestration (LangGraph / LangChain)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
