# ==============================================================================
# Agentic FacilityOps AI Platform - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Type Checking & Linting
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter & Data Science
.ipynb_checkpoints
*.pkl
*.joblib

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vite / React)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production Builds
frontend/dist/
frontend/dist-ssr/

# Vite Cache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# Databases & Logs
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.log
logs/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Production ML models - Causal V2 only
!backend/artifacts/causal_v2/*.joblib

# Local backup files
*.bak
